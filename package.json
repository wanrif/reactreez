{
  "name": "reactreez",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host",
    "start": "bunx --bun vite --host",
    "build": "tsc -b && vite build",
    "lint": "bunx biome lint --write ./src",
    "preview": "vite preview",
    "format": "bunx biome format --write --indent-style=space --indent-width=2 --jsx-quote-style=single ./src",
    "test": "vitest --changed --coverage.enabled --coverage.cleanOnRerun",
    "test:watch": "vitest --coverage.enabled --coverage.all --coverage.cleanOnRerun",
    "test:coverage": "vitest run --no-isolate --coverage.enabled --coverage.all --coverage.clean --coverage.thresholds.autoUpdate=true",
    "biome:explain": "bunx biome explain daemon-logs",
    "biome:clean": "bunx biome clean",
    "biome:sorting": "bunx biome check --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=true --write ./src"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@reduxjs/toolkit": "^2.4.0",
    "axios": "^1.7.9",
    "fast-json-stable-stringify": "^2.1.0",
    "i18next": "^23.16.8",
    "lodash": "^4.17.21",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^14.1.3",
    "react-icons": "^5.4.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "redux-persist": "^6.0.0",
    "zipson": "^0.2.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.0",
    "@types/bun": "^1.1.14",
    "@types/lodash": "^4.17.13",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "rollup-obfuscator": "^4.1.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.16",
    "terser": "^5.37.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.2",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@swc/core",
    "esbuild",
    "javascript-obfuscator"
  ]
}